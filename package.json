{
  "name": "taskflow-fullstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "deploy": "netlify deploy --build --prod",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:database": "node scripts/check-database.mjs",
    "workspace:password": "node scripts/workspace-password.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "mongodb": "^7.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "netlify-cli": "^27.12.0",
    "vite": "^8.2.2"
  },
  "description": "Shared task management workspace with React, Netlify Functions, and MongoDB Atlas.",
  "engines": {
    "node": ">=22"
  }
